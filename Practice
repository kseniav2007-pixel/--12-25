cat > check_comments <<'EOF'
#!/bin/bash

shopt -s nullglob

for file in *.c *.js *.py; do
    if [ ! -f "$file" ]; then
        continue
    fi

    IFS= read -r first_line < "$file" || true

    case "$file" in
        *.c|*.js)
            if [[ "$first_line" =~ ^[[:space:]]*(//|/\*) ]]; then
                echo "$file: comment found"
            else
                echo "$file: no comment"
            fi
            ;;
        *.py)
            if [[ "$first_line" =~ ^[[:space:]]*# ]]; then
                echo "$file: comment found"
            else
                echo "$file: no comment"
            fi
            ;;
    esac
done
EOF

chmod +x check_comments
printf '// Comment\nint main() {}\n' > test.c
printf 'console.log("Hello");\n' > test.js
