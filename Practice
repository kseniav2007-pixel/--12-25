#!/bin/bash

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 input_file output_file"
    exit 1
fi

input="$1"
output="$2"

if [ ! -f "$input" ]; then
    echo "Error: input file not found"
    exit 1
fi

if [ "$input" -ef "$output" ]; then
    echo "Error: input and output must be different files"
    exit 1
fi

if ! sed $'s/    /\t/g' "$input" > "$output"; then
    echo "Error: replacement failed"
    exit 1
fi

echo "Replacement completed: $output"
EOF

