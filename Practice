#!/bin/bash

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 directory extension"
    exit 1
fi

directory="$1"
extension="${2#.}"

if [ ! -d "$directory" ]; then
    echo "Error: directory not found"
    exit 1
fi

if [ -z "$extension" ]; then
    echo "Error: empty extension"
    exit 1
fi

archive="archive_${extension}.tar"

if ! find "$directory" -maxdepth 1 -type f -name "*.${extension}" \
    -printf '%f\0' | tar -cf "$archive" --null -T - -C "$directory"; then
    echo "Error: archive creation failed"
    exit 1
fi

echo "Archive created: $archive"
EOF

